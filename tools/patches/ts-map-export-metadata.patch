+            {
+                var name = Path.GetFileNameWithoutExtension(sectorFile);
+                if (!name.StartsWith("sec") || name.Length < 13) continue;
+                var file = UberFileSystem.Instance.GetFile(sectorFile);
+                if (file == null) continue;
+                sectorsJArr.Add(new JObject
+                {
+                    ["Archive"] = Path.GetFileName(file.Entry.GetArchiveFile().GetPath()),
+                    ["X"] = int.Parse(name.Substring(3, 5)),
+                    ["Y"] = int.Parse(name.Substring(8, 5))
+                });
+            }
